---
id: dashboard-header
name: Dashboard Header
description: A branded header with a search affordance and account profile.
category: Dashboards/Components
---
<style>
  .specux-dashboard-brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 11px;
    color: var(--theme-ink, #18243a);
    font-size: 15px;
    font-weight: 750;
    white-space: nowrap;
  }
  .specux-dashboard-brand-mark {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 10px;
    color: var(--theme-on-primary, #fff);
    background: var(--theme-primary, #4569e8);
    font-size: 15px;
  }
  .specux-dashboard-search {
    width: min(250px, 26vw);
    min-width: 0;
    margin-left: auto;
    padding: 9px 13px;
    border: 1px solid var(--theme-border, #e1e7ef);
    border-radius: 8px;
    color: var(--theme-muted, #8a95a7);
    background: var(--theme-surface-muted, #f8f9fc);
    font-size: 12px;
  }
  .specux-dashboard-profile {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-left: 20px;
    color: var(--theme-ink, #18243a);
    font-size: 12px;
    font-weight: 650;
  }
  .specux-dashboard-header-inner {
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
  }
  .specux-dashboard-avatar {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    color: var(--theme-primary, #3752b5);
    background: color-mix(in srgb, var(--theme-primary, #4569e8) 14%, var(--theme-surface, #fff));
    font-weight: 750;
  }
  @media (max-width: 520px) {
    .specux-dashboard-search { display: none; }
    .specux-dashboard-profile { margin-left: auto; }
  }
</style>
<div class="specux-dashboard-header-inner">
  <div class="specux-dashboard-brand"><span class="specux-dashboard-brand-mark">A</span> Acme Finance</div>
  <div class="specux-dashboard-search">Search transactions, accounts, help...</div>
  <div class="specux-dashboard-profile"><span class="specux-dashboard-avatar">JD</span><span>Jordan Davis</span></div>
</div>
