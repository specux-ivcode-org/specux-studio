---
id: dashboard-overview
name: Dashboard Overview
description: A responsive dashboard content layout with welcome, metric,
  activity, and insight regions.
category: Dashboards/Layout
slots:
  - id: welcome
    name: Welcome
  - id: metrics
    name: Metrics
  - id: activity
    name: Recent activity
  - id: insights
    name: Account insights
---
<style>
  .specux-overview {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "welcome"
      "metrics"
      "activity"
      "insights";
    gap: 14px;
    align-content: start;
    min-width: 0;
  }
  .specux-overview__welcome { grid-area: welcome; }
  .specux-overview__metrics {
    grid-area: metrics;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px !important;
  }
  .specux-overview__metrics > .asset-instance { min-width: 0; }
  .specux-overview__activity { grid-area: activity; }
  .specux-overview__insights { grid-area: insights; }
  @media (max-width: 520px) {
    .specux-overview__metrics { grid-template-columns: minmax(0, 1fr); }
  }
</style>
<section class="specux-overview" aria-label="Account overview">
  <div class="specux-overview__welcome" data-specux-slot="welcome"></div>
  <div class="specux-overview__metrics" data-specux-slot="metrics"></div>
  <div class="specux-overview__activity" data-specux-slot="activity"></div>
  <div class="specux-overview__insights" data-specux-slot="insights"></div>
</section>
