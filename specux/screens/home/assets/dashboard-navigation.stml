---
id: dashboard-navigation
name: Dashboard Navigation
description: A compact side navigation menu with an active overview destination.
category: Dashboards/Components
---
<style>
  .specux-dash-nav { display: grid; gap: 5px; }
  .specux-dash-nav-label {
    margin: 10px 10px 7px;
    color: var(--theme-muted, #98a2b3);
    font-size: 10px;
    font-weight: 750;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .specux-dash-nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 39px;
    padding: 0 11px;
    border-radius: 8px;
    color: var(--theme-muted, #69768c);
    font-size: 12px;
    font-weight: 600;
  }
  .specux-dash-nav-item--active {
    color: var(--theme-primary, #3556cf);
    background: color-mix(in srgb, var(--theme-primary, #4569e8) 13%, var(--theme-surface, #fff));
    font-weight: 700;
  }
  .specux-dash-nav-icon { width: 18px; text-align: center; font-size: 14px; }
  .specux-dash-nav-count {
    margin-left: auto;
    padding: 2px 6px;
    border-radius: 99px;
    color: var(--theme-muted, #5e6e89);
    background: var(--theme-surface-muted, #edf1f7);
    font-size: 10px;
  }
  @media (max-width: 760px) {
    .specux-dash-nav { display: flex; overflow-x: auto; gap: 3px; }
    .specux-dash-nav-label { display: none; }
    .specux-dash-nav-item { flex: none; padding: 0 10px; }
  }
</style>
<div class="specux-dash-nav">
  <div class="specux-dash-nav-label">Workspace</div>
  <div class="specux-dash-nav-item specux-dash-nav-item--active"><span class="specux-dash-nav-icon">▦</span>Overview</div>
  <div class="specux-dash-nav-item"><span class="specux-dash-nav-icon">◷</span>Transactions</div>
  <div class="specux-dash-nav-item"><span class="specux-dash-nav-icon">▤</span>Accounts</div>
  <div class="specux-dash-nav-item"><span class="specux-dash-nav-icon">↗</span>Payments<span class="specux-dash-nav-count">3</span></div>
  <div class="specux-dash-nav-label">Manage</div>
  <div class="specux-dash-nav-item"><span class="specux-dash-nav-icon">⚙</span>Settings</div>
  <div class="specux-dash-nav-item"><span class="specux-dash-nav-icon">?</span>Help center</div>
</div>
