---
id: sign-in-brand
name: Sign-in Brand
description: A compact brand mark and name for the sign-in page.
category: Forms/Sign-in
attributes:
  mark:
    type: string
    default: N
    overridable: true
  brand-name:
    type: string
    default: Northstar
    overridable: true
---
<style>
  .specux-sign-in-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    color: #fff;
    font: 750 14px/1.3 Inter, "Segoe UI", Arial, sans-serif;
    letter-spacing: .01em;
  }
  .specux-sign-in-brand__mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, .26);
    border-radius: 12px;
    background: rgba(255, 255, 255, .15);
    font-size: 18px;
  }
</style>
<div class="specux-sign-in-brand">
  <span class="specux-sign-in-brand__mark" aria-hidden="true">${attributes.mark}</span>
  <span>${attributes.brand-name}</span>
</div>
