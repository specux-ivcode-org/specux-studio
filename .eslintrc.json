{
  "root": true,
  "overrides": [
    {
      "files": ["backend/**/*.js"],
      "env": {
        "node": true,
        "es2022": true
      },
      "parserOptions": {
        "ecmaVersion": 2022
      },
      "rules": {
        "complexity": ["warn", 10]
      }
    },
    {
      "files": ["frontend/**/*.mjs"],
      "env": {
        "browser": true,
        "es2022": true
      },
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "rules": {
        "complexity": ["warn", 10]
      }
    }
  ]
}
